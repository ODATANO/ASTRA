# ODATANO ASTRA – runtime configuration (container / production)
# Copy to .env next to docker/docker-compose.yml on the box.

NODE_ENV=production
PORT=4004

# --- ASTRA's own database (aggregates only) --------------------------------
# postgres:// URL of the astra-postgres container (see docker/docker-compose.yml)
ASTRA_DB_URL=postgres://astra:CHANGE_ME@astra-postgres:5432/astra
ASTRA_PG_PASSWORD=CHANGE_ME

# --- Sources: the *existing* ODATANO and NIGHTGATE databases (read-only) ----
# One read-only role per source, created with scripts/sql/readonly-role.sql.
# "off" disables a chain. Host names are the Postgres containers on the box.
ASTRA_CARDANO_DB_URL=postgres://astra_ro:CHANGE_ME@odatano-postgres:5432/odatano
ASTRA_MIDNIGHT_DB_URL=postgres://astra_ro:CHANGE_ME@nightgate-postgres:5432/nightgate
# ASTRA_CARDANO_DB_POOL_MAX=4
# ASTRA_MIDNIGHT_DB_POOL_MAX=4

# --- Aggregation -------------------------------------------------------------
# History starts here (first run only; later runs continue from the cursor).
ASTRA_START_TIME=2026-01-01T00:00:00Z
ASTRA_POLL_MS=10000
ASTRA_CHUNK_BLOCKS=200
ASTRA_CYCLE_BUDGET_MS=20000
ASTRA_RETENTION_MINUTE_HOURS=48
ASTRA_RETENTION_HOUR_DAYS=90

# --- Dashboard: sister instances for the network switch (id=url, comma separated) ---
# Probed from the server every minute; an instance that does not answer is shown as "soon".
# Default follows the API pages: astra.preview.odatano.dev, astra.preprod.odatano.dev, astra.odatano.dev.
# ASTRA_NETWORKS=preview=https://astra.preview.odatano.dev,preprod=https://astra.preprod.odatano.dev,mainnet=https://astra.odatano.dev

# --- Auth (basic | dummy) ----------------------------------------------------
# Reads are public (@requires 'any'); admin actions (recompute, runNow) need the
# operator user. Set dummy only for local unauthenticated testing.
ASTRA_AUTH=basic
ASTRA_HTTP_USER=astra
ASTRA_HTTP_PASSWORD=CHANGE_ME
ASTRA_HTTP_ROLES=admin

# --- Docker networks of the source Postgres containers on the box ------------
ASTRA_CARDANO_NETWORK=cardano-preprod_default
ASTRA_MIDNIGHT_NETWORK=nightgate-deploy_default
